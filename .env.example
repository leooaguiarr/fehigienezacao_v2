# =============================================
# F&E Clean - Configuração de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores

# --- Firebase Firestore ---
# Acesse: https://console.firebase.google.com
# Projeto: fehizienizacao → Configurações → Seus apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fehizienizacao.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fehizienizacao
VITE_FIREBASE_STORAGE_BUCKET=fehizienizacao.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Painel Admin ---
# Senha para acessar o painel administrativo
VITE_ADMIN_PASSWORD=feclean2024

# --- n8n Automação (opcional) ---
# URL do webhook n8n para automação de agendamentos
# Automações: WhatsApp, email, Google Calendar, lembretes
# Deixe em branco para desativar (pode configurar depois)
VITE_N8N_WEBHOOK_URL=
